# ============================================================
#  Copy this file to ".env" and fill in your real values.
#  (In Namecheap cPanel you set these as Environment Variables
#   in the "Setup Node.js App" screen instead of a .env file.)
# ============================================================

# From Supabase: Project Settings → Data API → Project URL
# Use the BASE url only — no /rest/v1/ or any path after .co
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# From Supabase: Project Settings → API Keys → service_role  (SECRET — keep private!)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Local port (cPanel sets this automatically; leave as-is for local use)
PORT=3000
